# Env contract (PLAN §3). Never commit real values — copy to .env.local.
# Real values live in .env.local (gitignored, pulled via `npx neon deploy`).

# Pooled Postgres URL (server runtime)
DATABASE_URL="postgresql://user:pass@host/neondb?sslmode=require"
# Unpooled URL (migrations only)
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/neondb?sslmode=require"

# Managed Better Auth (public; also in .env.local after `neon deploy`)
NEON_BRANCH="production"
NEON_AUTH_BASE_URL="https://<branch>.neonauth.<region>.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://<branch>.neonauth.<region>.neon.tech/neondb/auth/.well-known/jwks.json"
# Server-side only (never ship to client bundles)
NEON_AUTH_COOKIE_SECRET=""

# App → server base URL (dev: local shelf; prod: Render Docker URL)
API_BASE_URL="http://localhost:8080"

# Demo mode flags (Phase 2; placeholder)
DEMO_TTL_HOURS="72"
